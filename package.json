{
  "name": "ai-web-test-agent",
  "version": "0.1.0",
  "private": true,
  "description": "基于 Codex SDK、Playwright MCP 与 Playwright Test 的 Agent-first Web 测试内核",
  "type": "module",
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json && tsc -p tsconfig.tests.json",
    "lint": "biome check src web/src tests vite.config.ts vitest.config.ts",
    "format": "biome format --write src web/src tests vite.config.ts vitest.config.ts",
    "test": "vitest run --config vitest.config.ts",
    "verify": "npm run typecheck && npm test && npm run lint && npm run build",
    "prestart": "npm run build:server",
    "start": "node --env-file=.env --enable-source-maps dist/cli/main.js",
    "preweb": "npm run build",
    "web": "node --env-file=.env --enable-source-maps dist/api/server.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@midscene/web": "^1.12.3",
    "@openai/codex-sdk": "^0.152.0",
    "@playwright/mcp": "^0.0.80",
    "fastify": "^5.12.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
