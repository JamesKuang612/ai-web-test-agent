{
  "name": "ai-web-test-agent",
  "version": "0.1.0",
  "private": true,
  "description": "基于 Codex SDK、Playwright MCP 与 Playwright Test 的 Agent-first Web 测试内核",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prestart": "npm run build",
    "start": "node --env-file=.env --enable-source-maps dist/index.js",
    "preweb": "npm run build",
    "web": "node --env-file=.env --enable-source-maps dist/server.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@midscene/web": "^1.12.3",
    "@openai/codex-sdk": "^0.152.0",
    "@playwright/mcp": "^0.0.80"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  }
}
