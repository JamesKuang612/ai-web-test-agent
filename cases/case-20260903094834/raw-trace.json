      "function": "() => {\n  const anchors = Array.from(document.querySelectorAll('a')).filter(a => /开放平台|开发者|插件/.test(a.textContent)).map(a => ({ href: a.href, text: a.textContent.trim() }));\n  const textMatches = [];\n  const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);\n  let node;\n  while (node = walker.nextNode()) {\n    if (/开放平台|插件管理|自建插件/.test(node.textContent)) textMatches.push(node.textContent.trim());\n  }\n  return { anchors, textMatches: [...new Set(textMatches)] };\n}"
